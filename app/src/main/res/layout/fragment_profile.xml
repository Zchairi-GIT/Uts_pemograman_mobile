<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ProfileFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_profile"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginTop="24dp"
            android:contentDescription="@string/profile_name"
            android:scaleType="centerCrop"
            android:src="@drawable/profil"
            app:shapeAppearanceOverlay="@style/CircleImageView" />

        <TextView
            android:id="@+id/tv_profile_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:text="@string/profile_name"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="1">

            <TableRow android:paddingBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="110dp"
                    android:text="@string/label_nama"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_nama"
                    android:text="@string/value_nama" />
            </TableRow>

            <TableRow android:paddingBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="110dp"
                    android:text="@string/label_nim"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_nim"
                    android:text="@string/value_nim" />
            </TableRow>

            <TableRow android:paddingBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="110dp"
                    android:text="@string/label_no_hp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_no_hp"
                    android:text="@string/value_no_hp" />
            </TableRow>

            <TableRow android:paddingBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="110dp"
                    android:text="@string/label_email"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_email"
                    android:text="@string/value_Email" />
            </TableRow>

            <TableRow android:paddingBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="110dp"
                    android:text="@string/label_perguruan"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_perguruan"
                    android:text="@string/value_perguruan" />
            </TableRow>

            <TableRow android:paddingBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="110dp"
                    android:text="@string/label_jurusan"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_jurusan"
                    android:text="@string/value_jurusan" />
            </TableRow>

            <TableRow android:paddingBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="110dp"
                    android:text="@string/label_prodi"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_prodi"
                    android:text="@string/value_prodi" />
            </TableRow>

            <TableRow android:paddingBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="110dp"
                    android:text="@string/label_alamat"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_alamat"
                    android:text="@string/value_alamat" />
            </TableRow>

            <TableRow android:paddingBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="110dp"
                    android:text="@string/label_matkul"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_matkul"
                    android:text="@string/value_matkul" />
            </TableRow>
        </TableLayout>
    </LinearLayout>
</ScrollView>