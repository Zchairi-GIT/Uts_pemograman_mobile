<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".DetailProductActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/btn_view_image">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/img_item_photo"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginTop="20dp"
                android:contentDescription="@string/image_detail_product"
                android:scaleType="centerInside"
                tools:src="@tools:sample/avatars" />

            <TextView
                android:id="@+id/tv_nama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/product_name"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:shrinkColumns="1"
                android:stretchColumns="1">

                <TableRow>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="110dp"
                        android:text="@string/label_id" />
                    <TextView android:id="@+id/tv_id" android:text="@string/label_id" />
                </TableRow>

                <TableRow android:layout_marginTop="5dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="110dp"
                        android:text="@string/label_brand" />
                    <TextView android:id="@+id/tv_brand" android:text="@string/label_brand" />
                </TableRow>

                <TableRow android:layout_marginTop="5dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="110dp"
                        android:text="@string/label_category" />
                    <TextView android:id="@+id/tv_category" android:text="@string/label_category" />
                </TableRow>

                <TableRow android:layout_marginTop="5dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="110dp"
                        android:text="@string/label_price" />
                    <TextView android:id="@+id/tv_price" android:text="@string/label_price" />
                </TableRow>

                <TableRow android:layout_marginTop="5dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="110dp"
                        android:text="@string/label_discount" />
                    <TextView android:id="@+id/tv_discount" android:text="@string/label_discount" />
                </TableRow>

                <TableRow android:layout_marginTop="5dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="110dp"
                        android:text="@string/label_rating" />
                    <TextView android:id="@+id/tv_rating" android:text="@string/label_rating" />
                </TableRow>

                <TableRow android:layout_marginTop="5dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="110dp"
                        android:text="@string/label_stock" />
                    <TextView android:id="@+id/tv_stock" android:text="@string/label_stock" />
                </TableRow>

                <TableRow android:layout_marginTop="5dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="110dp"
                        android:text="@string/label_availability" />
                    <TextView android:id="@+id/tv_availability" android:text="@string/label_availability" />
                </TableRow>

                <TableRow android:layout_marginTop="5dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="110dp"
                        android:text="@string/label_tags" />
                    <TextView android:id="@+id/tv_tags" android:text="@string/label_tags" />
                </TableRow>

                <TableRow android:layout_marginTop="5dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="110dp"
                        android:text="@string/label_dimensions" />
                    <TextView android:id="@+id/tv_dimensions" android:text="@string/label_dimensions" />
                </TableRow>

                <TableRow android:layout_marginTop="5dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="110dp"
                        android:text="@string/label_description" />
                    <TextView android:id="@+id/tv_description" android:text="@string/label_description" />
                </TableRow>

                <TableRow android:layout_marginTop="5dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="110dp"
                        android:text="@string/label_reviews" />
                    <TextView android:id="@+id/tv_reviews" android:text="@string/label_reviews" />
                </TableRow>
            </TableLayout>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_view_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="8dp"
        android:text="@string/tampilkan_gambar" />
</RelativeLayout>